MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=fitai_trainer
MYSQL_USER=fitai
MYSQL_PASSWORD=change-this-db-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost

# AI is local-first. No API key is required.
AI_PROVIDER=local
LOCAL_LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud enhancement; leave blank for zero-key mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
RESEND_API_KEY=
EMAIL_FROM=FitAI Trainer <onboarding@resend.dev>

AI_SERVICE_URL=http://ai-service:8000
ENABLE_EXERCISE_YOLO=true
EXERCISE_YOLO_MODEL=/app/models/best.pt
EXERCISE_YOLO_CONF=0.45
EXERCISE_YOLO_IMGSZ=640
