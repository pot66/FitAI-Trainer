PORT=5000

# For local dev (MySQL running on your machine, or exposed via
# docker-compose's "mysql" service on host port 3307):
DATABASE_URL="mysql://fitai:fitai_password@localhost:3307/fitai_trainer"

# If the backend itself runs inside docker-compose, use the service name
# and the container-internal port instead (docker-compose.yml sets this
# automatically via the `environment:` block on the backend service):
# DATABASE_URL="mysql://fitai:fitai_password@mysql:3306/fitai_trainer"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Ollama runs locally by default. Pull a model first, e.g. `ollama pull llama3.2:3b`.
OLLAMA_ENABLED="true"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_MS="30000"
